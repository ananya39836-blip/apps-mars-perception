{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Level 2 Evidence Assessment (Appendix CR)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/assess_level2.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Master Level 2 Pipeline (Full Verification)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/experiments/run_level2.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Master Level 2 Pipeline (Smoke Mode)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/experiments/run_level2.py",
            "args": ["--smoke"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Interactive Streamlit Demo (Level 2: app_l2.py)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "app_l2.py"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Level 1 Evidence Assessment (Appendix AO/BX)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/assess_level1.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Master Level 1 Pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/experiments/run_level1.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Interactive Streamlit Demo (Level 1: app_l1.py)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "app_l1.py"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Pytest Suite (All 46 Tests)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests", "-v"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
