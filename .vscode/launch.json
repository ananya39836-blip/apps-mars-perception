{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Master Level 1 Pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/experiments/run_level1.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Master Pipeline (Smoke Mode)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/experiments/run_level1.py",
            "args": ["--smoke"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Level 1 Evidence Assessment",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/assess_level1.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Interactive Streamlit Demo (app_l1.py)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "app_l1.py"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Pytest Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/test_level1.py", "tests/test_all.py", "-v"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
